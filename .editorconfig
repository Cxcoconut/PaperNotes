root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{cpp,h,rc}]
indent_size = 2

[*.{ps1,psm1}]
# Windows PowerShell 5.1 reads BOM-less UTF-8 as ANSI, which corrupts Chinese
# literals and breaks parsing. Scripts are stored as UTF-8 with BOM.
charset = utf-8-bom
end_of_line = crlf

[*.{vcxproj,props,targets,xml,manifest}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.py]
indent_size = 4

[*.yml]
indent_size = 2
