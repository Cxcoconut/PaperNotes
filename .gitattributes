# Normalize line endings so a Windows checkout and a CI checkout agree.
* text=auto

# PowerShell scripts must keep CRLF: Windows PowerShell 5.1 is happiest with it,
# and the files carry a UTF-8 BOM that must survive (see .editorconfig).
*.ps1 text eol=crlf
*.psm1 text eol=crlf

# Source and docs are fine with LF.
*.cpp text eol=lf
*.h text eol=lf
*.rc text eol=lf
*.md text eol=lf
*.py text eol=lf
*.yml text eol=lf

# Project files are Windows-only; keep them CRLF.
*.vcxproj text eol=crlf
*.xml text eol=crlf
*.manifest text eol=crlf
*.cmd text eol=crlf

# Binary assets: never touch.
*.png binary
*.ico binary
*.pfx binary
*.cer binary
